{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chestnut-chat-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "queues": {
    "producers": [{ "binding": "MEMORY_QUEUE", "queue": "chestnut-chat-memory" }],
    "consumers": [
      {
        "queue": "chestnut-chat-memory",
        "max_batch_size": 10,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
        "max_retries": 100,
        "retry_delay": 5,
      },
    ],
  },
  // Secrets (DATABASE_URL, BETTER_AUTH_SECRET, provider keys, ...) are managed with `wrangler secret`.
  "vars": {
    "BETTER_AUTH_URL": "https://chestnut-chat.bobbylin.top",
    "CORS_ORIGIN": "https://chestnut-chat.bobbylin.top",
  },
}
