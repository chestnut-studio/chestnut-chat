{
  "name": "@chestnut-chat/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:ensure-extensions": "tsx src/ensure-extensions.ts",
    "db:push": "pnpm run db:ensure-extensions && drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "pnpm run db:ensure-extensions && drizzle-kit migrate"
  },
  "dependencies": {
    "@chestnut-chat/env": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chestnut-chat/config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
